{
	"schemaVersion": 1,
	"id": "infinite-inventory",
	"version": "${version}",
	"name": "Infinite Inventory",
	"description": "Adds a secondary infinitely-expandable inventory that acts as a chest accessible at all times!",
	"authors": [
		"robsterad"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/infinite-inventory/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.robsterad.infiniteinv.InfiniteInv"
		],
		"client": [
			"com.robsterad.infiniteinv.InfiniteInvClient"
		]
	},
	"mixins": [
		"infinite-inventory.mixins.json",
		{
			"config": "infinite-inventory.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": ">=26.1.1 <26.2.0",
		"java": ">=25",
		"fabric-api": "*"
	}
}